{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:study:protocol:v1",
  "$defs": {
    "Capabilities": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "version": {
          "type": "number",
          "const": 1
        },
        "supportedVersions": {
          "type": "array",
          "items": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 100,
            "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
          }
        }
      },
      "required": [
        "version",
        "supportedVersions",
        "capabilities"
      ],
      "additionalProperties": false
    },
    "Command": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "version": {
          "type": "number",
          "const": 1
        },
        "requestId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "command": {
          "type": "string",
          "maxLength": 100,
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
        },
        "payload": {},
        "csrf": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        }
      },
      "required": [
        "version",
        "requestId",
        "command",
        "payload"
      ],
      "additionalProperties": false
    },
    "CsrfResponse": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "csrfToken": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        }
      },
      "required": [
        "csrfToken"
      ],
      "additionalProperties": false
    },
    "Error": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "version": {
          "type": "number",
          "const": 1
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "UNAUTHENTICATED",
                "FORBIDDEN",
                "NOT_FOUND",
                "INVALID_REQUEST",
                "CSRF_REJECTED",
                "ORIGIN_REJECTED",
                "RATE_LIMITED",
                "CONFLICT",
                "UNAVAILABLE",
                "INTERNAL"
              ]
            },
            "message": {
              "type": "string"
            },
            "requestId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          "required": [
            "code",
            "message",
            "requestId"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "version",
        "error"
      ],
      "additionalProperties": false
    },
    "Event": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "version": {
          "type": "number",
          "const": 1
        },
        "eventId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "event": {
          "type": "string",
          "maxLength": 100,
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "payload": {}
      },
      "required": [
        "version",
        "eventId",
        "event",
        "occurredAt",
        "payload"
      ],
      "additionalProperties": false
    },
    "Health": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "ok",
            "unavailable"
          ]
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": false
    },
    "TileLayout": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "version": {
          "type": "number",
          "const": 1
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 20000
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 20000
        },
        "zIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "minimized": {
          "type": "boolean"
        },
        "fullscreen": {
          "type": "boolean"
        }
      },
      "required": [
        "version",
        "x",
        "y",
        "width",
        "height",
        "zIndex",
        "minimized",
        "fullscreen"
      ],
      "additionalProperties": false
    },
    "Result": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "version": {
          "type": "number",
          "const": 1
        },
        "requestId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "result": {}
      },
      "required": [
        "version",
        "requestId",
        "result"
      ],
      "additionalProperties": false
    }
  }
}
