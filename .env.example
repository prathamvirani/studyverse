# Reference only: npm run dev creates random local credentials in .local/compose.env.
# Keep actual values in ignored files or a production secret manager.
NODE_ENV=development
APP_ORIGIN=https://localhost:8443
API_HOST=127.0.0.1
API_PORT=3001
DATABASE_URL=postgresql://study_runtime:REPLACE_AT_SETUP@localhost:5433/study
MIGRATION_DATABASE_URL=postgresql://study_migrator:REPLACE_AT_SETUP@localhost:5433/study
REDIS_URL=redis://:REPLACE_AT_SETUP@localhost:6380
LOG_LEVEL=info
WS_REVALIDATE_MS=5000
INGRESS_LIMIT=300
IDENTITY_ROOMS_ENABLED=true
# Legacy PHASE01_ENABLED is also supported; either false disables identity/rooms.
# Optional provider pairs. Set BOTH values to enable a provider; never commit real secrets.
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=
OAUTH_MICROSOFT_TENANT=common
OAUTH_MICROSOFT_ENABLED=false
OAUTH_DISCORD_CLIENT_ID=
OAUTH_DISCORD_CLIENT_SECRET=
SOCIAL_ENABLED=true
# Legacy PHASE03_ENABLED is also supported; either false disables social actions.

POMODORO_ENABLED=true
TASKS_ENABLED=true
CHAT_ENABLED=true
BACKGROUNDS_ENABLED=true
## Standalone API defaults off. `npm run dev` generates protected keys and enables local RTC.
RTC_ENABLED=false
LIVEKIT_URL=
LIVEKIT_SERVICE_URL=
# Optional isolated deployment namespace (one authority process per namespace).
LIVEKIT_ROOM_PREFIX=study-
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
